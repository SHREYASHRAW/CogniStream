{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CogniStream Developer Activity Event",
  "description": "Canonical schema for normalized developer activity events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source",
    "event_type",
    "developer_id",
    "team_id",
    "timestamp",
    "metadata"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": ["github", "slack", "jira", "ide"]
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "developer_id": {
      "type": "string",
      "minLength": 1
    },
    "team_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
