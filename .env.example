# CogniStream configuration example
# Copy to .env for local use and replace values as needed.

COGNISTREAM_ENV=development

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=cognistream
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Local data paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
